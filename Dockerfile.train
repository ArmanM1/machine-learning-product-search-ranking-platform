# syntax=docker/dockerfile:1.7
# Linux/amd64 digest for the patched Python 3.11.16 slim-bookworm release.
FROM python:3.11.16-slim-bookworm@sha256:b1add8a6f2aca6bcfcf0b9c9b522352f7ce0d62a3d556a2f2f32511aa0cca250

ARG UV_VERSION=0.12.9

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}" \
    HF_HOME=/opt/ml/cache/huggingface \
    TRANSFORMERS_CACHE=/opt/ml/cache/huggingface \
    CUBLAS_WORKSPACE_CONFIG=:4096:8 \
    SEARCH_RANK_CHECKPOINT_DIR=/opt/ml/checkpoints

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends --only-upgrade libpcre2-8-0 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/ml/model /opt/ml/output /opt/ml/checkpoints /opt/ml/cache/huggingface

COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY src ./src
COPY configs ./configs
COPY scripts/container_train.py ./scripts/container_train.py

RUN system_python="$(command -v python)" \
    && "${system_python}" -m pip install --no-cache-dir "uv==${UV_VERSION}" \
    && uv sync --frozen --no-dev --no-editable \
    && "${system_python}" -m pip uninstall --yes uv setuptools wheel \
    && find /app/.venv -type d -name __pycache__ -prune -exec rm -rf '{}' +

# SageMaker owns and mounts the /opt/ml training contract at runtime. The bounded
# batch job therefore runs as root inside the container so those mounts remain writable.
USER root

ENTRYPOINT ["python", "/app/scripts/container_train.py"]
