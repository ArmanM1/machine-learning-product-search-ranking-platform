{
  "$defs": {
    "ColdStartControlProof": {
      "additionalProperties": false,
      "properties": {
        "candidate_version_changed": {
          "const": true,
          "title": "Candidate Version Changed",
          "type": "boolean"
        },
        "new_version_prior_cloudwatch_event_count": {
          "const": 0,
          "title": "New Version Prior Cloudwatch Event Count",
          "type": "integer"
        },
        "newly_published_after_apply_started": {
          "const": true,
          "title": "Newly Published After Apply Started",
          "type": "boolean"
        },
        "on_demand_execution": {
          "const": true,
          "title": "On Demand Execution",
          "type": "boolean"
        },
        "previous_candidate_version": {
          "pattern": "^(absent|[1-9][0-9]*)$",
          "title": "Previous Candidate Version",
          "type": "string"
        },
        "provisioned_concurrency": {
          "const": 0,
          "title": "Provisioned Concurrency",
          "type": "integer"
        },
        "reserved_concurrency": {
          "const": 2,
          "title": "Reserved Concurrency",
          "type": "integer"
        }
      },
      "required": [
        "newly_published_after_apply_started",
        "candidate_version_changed",
        "previous_candidate_version",
        "new_version_prior_cloudwatch_event_count",
        "on_demand_execution",
        "reserved_concurrency",
        "provisioned_concurrency"
      ],
      "title": "ColdStartControlProof",
      "type": "object"
    },
    "ColdStartFirstRequest": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "maximum": 40,
          "minimum": 1,
          "title": "Candidate Count",
          "type": "integer"
        },
        "end_to_end_latency_ms": {
          "exclusiveMinimum": 0,
          "title": "End To End Latency Ms",
          "type": "number"
        },
        "http_status": {
          "const": 200,
          "title": "Http Status",
          "type": "integer"
        },
        "model_latency_ms": {
          "minimum": 0,
          "title": "Model Latency Ms",
          "type": "number"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "route": {
          "const": "/api/v1/rank",
          "title": "Route",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "route",
        "http_status",
        "candidate_count",
        "end_to_end_latency_ms",
        "model_latency_ms"
      ],
      "title": "ColdStartFirstRequest",
      "type": "object"
    },
    "ColdStartIdentifiers": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "const": "candidate",
          "title": "Alias",
          "type": "string"
        },
        "dataset_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Dataset Manifest Hash",
          "type": "string"
        },
        "function_name": {
          "minLength": 1,
          "title": "Function Name",
          "type": "string"
        },
        "function_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Function Version",
          "type": "string"
        },
        "model_artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Artifact Checksum",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "region": {
          "const": "us-east-1",
          "title": "Region",
          "type": "string"
        },
        "release_id": {
          "minLength": 1,
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "model_id",
        "dataset_manifest_hash",
        "model_artifact_checksum",
        "function_name",
        "alias",
        "function_version",
        "region"
      ],
      "title": "ColdStartIdentifiers",
      "type": "object"
    },
    "ColdStartLambdaReport": {
      "additionalProperties": false,
      "properties": {
        "billed_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Billed Duration Ms",
          "type": "number"
        },
        "configured_memory_mb": {
          "const": 4096,
          "title": "Configured Memory Mb",
          "type": "integer"
        },
        "init_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Init Duration Ms",
          "type": "number"
        },
        "invocation_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Invocation Duration Ms",
          "type": "number"
        },
        "max_memory_used_mb": {
          "exclusiveMinimum": 0,
          "title": "Max Memory Used Mb",
          "type": "number"
        }
      },
      "required": [
        "init_duration_ms",
        "invocation_duration_ms",
        "billed_duration_ms",
        "configured_memory_mb",
        "max_memory_used_mb"
      ],
      "title": "ColdStartLambdaReport",
      "type": "object"
    },
    "ColdStartStructuredRequest": {
      "additionalProperties": false,
      "properties": {
        "process_peak_memory_mb": {
          "exclusiveMinimum": 0,
          "title": "Process Peak Memory Mb",
          "type": "number"
        }
      },
      "required": [
        "process_peak_memory_mb"
      ],
      "title": "ColdStartStructuredRequest",
      "type": "object"
    },
    "ColdStartStructuredStartup": {
      "additionalProperties": false,
      "properties": {
        "model_load_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Model Load Duration Ms",
          "type": "number"
        },
        "startup_succeeded": {
          "const": true,
          "title": "Startup Succeeded",
          "type": "boolean"
        }
      },
      "required": [
        "startup_succeeded",
        "model_load_duration_ms"
      ],
      "title": "ColdStartStructuredStartup",
      "type": "object"
    }
  },
  "$id": "https://schemas.example.invalid/search-rank/cold_start_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One controlled first invocation, intentionally separate from warm samples.",
  "properties": {
    "control_proof": {
      "$ref": "#/$defs/ColdStartControlProof"
    },
    "controlled_cold_start": {
      "const": true,
      "title": "Controlled Cold Start",
      "type": "boolean"
    },
    "excluded_from_warm_samples": {
      "const": true,
      "title": "Excluded From Warm Samples",
      "type": "boolean"
    },
    "first_request": {
      "$ref": "#/$defs/ColdStartFirstRequest"
    },
    "identifiers": {
      "$ref": "#/$defs/ColdStartIdentifiers"
    },
    "lambda_report": {
      "$ref": "#/$defs/ColdStartLambdaReport"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "measured_at": {
      "format": "date-time",
      "title": "Measured At",
      "type": "string"
    },
    "measurement_class": {
      "const": "controlled_on_demand_lambda_cold_start",
      "title": "Measurement Class",
      "type": "string"
    },
    "sample_count": {
      "const": 1,
      "title": "Sample Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "measured",
      "title": "Status",
      "type": "string"
    },
    "structured_request": {
      "$ref": "#/$defs/ColdStartStructuredRequest"
    },
    "structured_startup": {
      "$ref": "#/$defs/ColdStartStructuredStartup"
    }
  },
  "required": [
    "schema_version",
    "status",
    "measurement_class",
    "controlled_cold_start",
    "measured_at",
    "identifiers",
    "control_proof",
    "first_request",
    "lambda_report",
    "structured_startup",
    "structured_request",
    "sample_count",
    "excluded_from_warm_samples",
    "limitations"
  ],
  "title": "ColdStartEvidence",
  "type": "object"
}
