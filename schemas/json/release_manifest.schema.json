{
  "$defs": {
    "ModelSummary": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "base_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Model Id"
        },
        "artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Checksum",
          "type": "string"
        },
        "evaluation_report_id": {
          "minLength": 1,
          "title": "Evaluation Report Id",
          "type": "string"
        },
        "promoted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promoted At"
        },
        "limitations_url": {
          "minLength": 1,
          "title": "Limitations Url",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "display_name",
        "kind",
        "artifact_checksum",
        "evaluation_report_id",
        "limitations_url"
      ],
      "title": "ModelSummary",
      "type": "object"
    },
    "PublicEvaluationProvenance": {
      "additionalProperties": false,
      "description": "Allowlisted provenance for the two clean held-out Processing executions.",
      "properties": {
        "candidate_model_id": {
          "minLength": 1,
          "title": "Candidate Model Id",
          "type": "string"
        },
        "candidate_model_artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Model Artifact Checksum",
          "type": "string"
        },
        "evaluation_config_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evaluation Config Hash",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "hardware_class": {
          "const": "ml.m5.xlarge",
          "title": "Hardware Class",
          "type": "string"
        },
        "region": {
          "const": "us-east-1",
          "title": "Region",
          "type": "string"
        },
        "clean_execution_count": {
          "const": 2,
          "title": "Clean Execution Count",
          "type": "integer"
        },
        "runtime_seconds": {
          "minimum": 0,
          "title": "Runtime Seconds",
          "type": "number"
        },
        "runtime_basis": {
          "const": "processing_job_wall_clock_sum",
          "title": "Runtime Basis",
          "type": "string"
        },
        "estimated_cost_usd": {
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "actual_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Cost Usd"
        },
        "cost_evidence": {
          "minLength": 1,
          "title": "Cost Evidence",
          "type": "string"
        }
      },
      "required": [
        "candidate_model_id",
        "candidate_model_artifact_checksum",
        "evaluation_config_hash",
        "git_sha",
        "image_digest",
        "hardware_class",
        "region",
        "clean_execution_count",
        "runtime_seconds",
        "runtime_basis",
        "estimated_cost_usd",
        "cost_evidence"
      ],
      "title": "PublicEvaluationProvenance",
      "type": "object"
    },
    "PublicTrainingProvenance": {
      "additionalProperties": false,
      "description": "Allowlisted provenance for the validation-selected training execution.",
      "properties": {
        "trial_selection_id": {
          "pattern": "^trial-selection-[0-9a-f]{20}$",
          "title": "Trial Selection Id",
          "type": "string"
        },
        "trial_selection_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Trial Selection Sha256",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "selected_model_id": {
          "minLength": 1,
          "title": "Selected Model Id",
          "type": "string"
        },
        "selected_model_artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Selected Model Artifact Checksum",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "hardware_class": {
          "enum": [
            "ml.m5.xlarge",
            "ml.g4dn.xlarge"
          ],
          "title": "Hardware Class",
          "type": "string"
        },
        "accelerator": {
          "enum": [
            "cpu",
            "gpu"
          ],
          "title": "Accelerator",
          "type": "string"
        },
        "region": {
          "const": "us-east-1",
          "title": "Region",
          "type": "string"
        },
        "runtime_seconds": {
          "minimum": 0,
          "title": "Runtime Seconds",
          "type": "number"
        },
        "estimated_cost_usd": {
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "actual_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Cost Usd"
        },
        "cost_evidence": {
          "minLength": 1,
          "title": "Cost Evidence",
          "type": "string"
        }
      },
      "required": [
        "trial_selection_id",
        "trial_selection_sha256",
        "run_id",
        "run_manifest_sha256",
        "selected_model_id",
        "selected_model_artifact_checksum",
        "config_hash",
        "git_sha",
        "image_digest",
        "hardware_class",
        "accelerator",
        "region",
        "runtime_seconds",
        "estimated_cost_usd",
        "cost_evidence"
      ],
      "title": "PublicTrainingProvenance",
      "type": "object"
    },
    "ReleaseExecutionProvenance": {
      "additionalProperties": false,
      "properties": {
        "training": {
          "$ref": "#/$defs/PublicTrainingProvenance"
        },
        "evaluation": {
          "$ref": "#/$defs/PublicEvaluationProvenance"
        }
      },
      "required": [
        "training",
        "evaluation"
      ],
      "title": "ReleaseExecutionProvenance",
      "type": "object"
    },
    "ReleaseModel": {
      "additionalProperties": false,
      "description": "One executable model entry in a release bundle.",
      "properties": {
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "bm25",
            "pretrained",
            "fine_tuned"
          ],
          "title": "Kind",
          "type": "string"
        },
        "checkpoint": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint"
        },
        "text_template": {
          "enum": [
            "title_v1",
            "enriched_v1"
          ],
          "title": "Text Template",
          "type": "string"
        },
        "artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Checksum",
          "type": "string"
        },
        "batch_size": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Size"
        },
        "public_summary": {
          "$ref": "#/$defs/ModelSummary"
        }
      },
      "required": [
        "model_id",
        "kind",
        "text_template",
        "artifact_checksum",
        "public_summary"
      ],
      "title": "ReleaseModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Typed executable and provenance manifest for one immutable public bundle.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "release_id": {
      "maxLength": 100,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,99}$",
      "title": "Release Id",
      "type": "string"
    },
    "promoted_model_id": {
      "minLength": 1,
      "title": "Promoted Model Id",
      "type": "string"
    },
    "dataset_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dataset Manifest Hash",
      "type": "string"
    },
    "split_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Split Manifest Hash",
      "type": "string"
    },
    "evaluation_report_id": {
      "minLength": 1,
      "title": "Evaluation Report Id",
      "type": "string"
    },
    "git_sha": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Git Sha",
      "type": "string"
    },
    "evidence_mode": {
      "enum": [
        "validation_only",
        "verified"
      ],
      "title": "Evidence Mode",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseExecutionProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifact_checksums": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._/-]*$": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 512,
        "minLength": 1
      },
      "title": "Artifact Checksums",
      "type": "object"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ReleaseModel"
      },
      "minItems": 2,
      "title": "Models",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "promoted_model_id",
    "dataset_manifest_hash",
    "split_manifest_hash",
    "evaluation_report_id",
    "git_sha",
    "evidence_mode",
    "artifact_checksums",
    "models"
  ],
  "title": "ReleaseManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/search-rank/release_manifest.schema.json"
}
