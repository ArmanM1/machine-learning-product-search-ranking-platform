{
  "$defs": {
    "CuratedQuerySummary": {
      "additionalProperties": false,
      "properties": {
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "candidate_count": {
          "maximum": 40,
          "minimum": 1,
          "title": "Candidate Count",
          "type": "integer"
        }
      },
      "required": [
        "query_id",
        "query",
        "candidate_count"
      ],
      "title": "CuratedQuerySummary",
      "type": "object"
    },
    "PublicEvaluationEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_mode": {
          "const": "verified",
          "default": "verified",
          "title": "Evidence Mode",
          "type": "string"
        },
        "report_id": {
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "candidate_model_id": {
          "minLength": 1,
          "title": "Candidate Model Id",
          "type": "string"
        },
        "strongest_baseline_model_id": {
          "minLength": 1,
          "title": "Strongest Baseline Model Id",
          "type": "string"
        },
        "release_status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Release Status",
          "type": "string"
        },
        "primary_metric": {
          "$ref": "#/$defs/PublicMetricValue"
        },
        "strongest_baseline": {
          "$ref": "#/$defs/PublicMetricValue"
        },
        "delta": {
          "$ref": "#/$defs/PublicMetricValue"
        },
        "held_out_query_count": {
          "minimum": 1,
          "title": "Held Out Query Count",
          "type": "integer"
        },
        "bootstrap_resamples": {
          "minimum": 10000,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "bootstrap_seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Bootstrap Seed",
          "type": "integer"
        },
        "test_access_count": {
          "minimum": 1,
          "title": "Test Access Count",
          "type": "integer"
        },
        "excluded_query_count": {
          "minimum": 0,
          "title": "Excluded Query Count",
          "type": "integer"
        },
        "exclusion_note": {
          "minLength": 1,
          "title": "Exclusion Note",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/PublicModelMetricRow"
          },
          "minItems": 2,
          "title": "Models",
          "type": "array"
        },
        "secondary_metrics": {
          "items": {
            "$ref": "#/$defs/PublicMetricComparison"
          },
          "title": "Secondary Metrics",
          "type": "array"
        }
      },
      "required": [
        "report_id",
        "run_id",
        "candidate_model_id",
        "strongest_baseline_model_id",
        "release_status",
        "primary_metric",
        "strongest_baseline",
        "delta",
        "held_out_query_count",
        "bootstrap_resamples",
        "bootstrap_seed",
        "test_access_count",
        "excluded_query_count",
        "exclusion_note",
        "models",
        "secondary_metrics"
      ],
      "title": "PublicEvaluationEvidence",
      "type": "object"
    },
    "PublicEvaluationProvenance": {
      "additionalProperties": false,
      "description": "Allowlisted provenance for the two clean held-out Processing executions.",
      "properties": {
        "candidate_model_id": {
          "minLength": 1,
          "title": "Candidate Model Id",
          "type": "string"
        },
        "candidate_model_artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Model Artifact Checksum",
          "type": "string"
        },
        "evaluation_config_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evaluation Config Hash",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "hardware_class": {
          "const": "ml.m5.xlarge",
          "title": "Hardware Class",
          "type": "string"
        },
        "region": {
          "const": "us-east-1",
          "title": "Region",
          "type": "string"
        },
        "clean_execution_count": {
          "const": 2,
          "title": "Clean Execution Count",
          "type": "integer"
        },
        "runtime_seconds": {
          "minimum": 0,
          "title": "Runtime Seconds",
          "type": "number"
        },
        "runtime_basis": {
          "const": "processing_job_wall_clock_sum",
          "title": "Runtime Basis",
          "type": "string"
        },
        "estimated_cost_usd": {
          "minimum": 0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "actual_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Cost Usd"
        },
        "cost_evidence": {
          "minLength": 1,
          "title": "Cost Evidence",
          "type": "string"
        }
      },
      "required": [
        "candidate_model_id",
        "candidate_model_artifact_checksum",
        "evaluation_config_hash",
        "git_sha",
        "image_digest",
        "hardware_class",
        "region",
        "clean_execution_count",
        "runtime_seconds",
        "runtime_basis",
        "estimated_cost_usd",
        "cost_evidence"
      ],
      "title": "PublicEvaluationProvenance",
      "type": "object"
    },
    "PublicFailureAnalysis": {
      "additionalProperties": false,
      "properties": {
        "evidence_mode": {
          "const": "verified",
          "default": "verified",
          "title": "Evidence Mode",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "metric": {
          "const": "graded_ndcg@10",
          "default": "graded_ndcg@10",
          "title": "Metric",
          "type": "string"
        },
        "minimum_slice_size": {
          "minimum": 1,
          "title": "Minimum Slice Size",
          "type": "integer"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/PublicSliceResult"
          },
          "title": "Slices",
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/PublicFailureExample"
          },
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "minimum_slice_size",
        "slices",
        "examples"
      ],
      "title": "PublicFailureAnalysis",
      "type": "object"
    },
    "PublicFailureExample": {
      "additionalProperties": false,
      "properties": {
        "example_id": {
          "minLength": 1,
          "title": "Example Id",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/CuratedQuerySummary"
        },
        "category": {
          "enum": [
            "win",
            "loss",
            "tie_or_uncertain",
            "lexical_preferred",
            "complement_exact_confusion"
          ],
          "title": "Category",
          "type": "string"
        },
        "baseline_metric": {
          "title": "Baseline Metric",
          "type": "number"
        },
        "candidate_metric": {
          "title": "Candidate Metric",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "selection_rule": {
          "minLength": 1,
          "title": "Selection Rule",
          "type": "string"
        },
        "public_product_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Public Product Ids",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "interpretation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation"
        },
        "next_experiment": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Experiment"
        }
      },
      "required": [
        "example_id",
        "query",
        "category",
        "baseline_metric",
        "candidate_metric",
        "delta",
        "selection_rule"
      ],
      "title": "PublicFailureExample",
      "type": "object"
    },
    "PublicInterval": {
      "additionalProperties": false,
      "properties": {
        "point_estimate": {
          "title": "Point Estimate",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "confidence_level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Confidence Level",
          "type": "number"
        }
      },
      "required": [
        "point_estimate",
        "lower",
        "upper",
        "confidence_level"
      ],
      "title": "PublicInterval",
      "type": "object"
    },
    "PublicMetricComparison": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "graded_ndcg@10",
            "exact_mrr@10",
            "recall_exact_or_substitute@10",
            "pairwise_ordinal_accuracy",
            "graded_ndcg@5",
            "exact_top_1_rate"
          ],
          "title": "Metric",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "baseline": {
          "title": "Baseline",
          "type": "number"
        },
        "candidate": {
          "title": "Candidate",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "display_name",
        "baseline",
        "candidate",
        "delta"
      ],
      "title": "PublicMetricComparison",
      "type": "object"
    },
    "PublicMetricValue": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "graded_ndcg@10",
            "exact_mrr@10",
            "recall_exact_or_substitute@10",
            "pairwise_ordinal_accuracy",
            "graded_ndcg@5",
            "exact_top_1_rate"
          ],
          "title": "Metric",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "metric",
        "display_name",
        "value"
      ],
      "title": "PublicMetricValue",
      "type": "object"
    },
    "PublicModelMetricRow": {
      "additionalProperties": false,
      "description": "Measured model values only; unavailable measurements stay null.",
      "properties": {
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "bm25",
            "pretrained",
            "fine_tuned"
          ],
          "title": "Kind",
          "type": "string"
        },
        "graded_ndcg_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Graded Ndcg At 10",
          "type": "number"
        },
        "exact_mrr_at_10": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Mrr At 10"
        },
        "recall_exact_or_substitute_at_10": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall Exact Or Substitute At 10"
        },
        "pairwise_ordinal_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairwise Ordinal Accuracy"
        },
        "graded_ndcg_at_5": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graded Ndcg At 5"
        },
        "exact_top_1_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Top 1 Rate"
        },
        "p95_inference_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Inference Latency Ms"
        }
      },
      "required": [
        "model_id",
        "display_name",
        "kind",
        "graded_ndcg_at_10"
      ],
      "title": "PublicModelMetricRow",
      "type": "object"
    },
    "PublicRunIntervals": {
      "additionalProperties": false,
      "properties": {
        "candidate_minus_baseline_graded_ndcg_at_10": {
          "$ref": "#/$defs/PublicInterval"
        }
      },
      "required": [
        "candidate_minus_baseline_graded_ndcg_at_10"
      ],
      "title": "PublicRunIntervals",
      "type": "object"
    },
    "PublicRunMetrics": {
      "additionalProperties": false,
      "properties": {
        "candidate_graded_ndcg_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Candidate Graded Ndcg At 10",
          "type": "number"
        },
        "strongest_baseline_graded_ndcg_at_10": {
          "maximum": 1,
          "minimum": 0,
          "title": "Strongest Baseline Graded Ndcg At 10",
          "type": "number"
        },
        "candidate_minus_baseline_graded_ndcg_at_10": {
          "title": "Candidate Minus Baseline Graded Ndcg At 10",
          "type": "number"
        }
      },
      "required": [
        "candidate_graded_ndcg_at_10",
        "strongest_baseline_graded_ndcg_at_10",
        "candidate_minus_baseline_graded_ndcg_at_10"
      ],
      "title": "PublicRunMetrics",
      "type": "object"
    },
    "PublicRunSummary": {
      "additionalProperties": false,
      "description": "Allowlisted public evidence; intentionally omits cloud identifiers/URIs.",
      "properties": {
        "evidence_mode": {
          "const": "verified",
          "default": "verified",
          "title": "Evidence Mode",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "const": "complete",
          "default": "complete",
          "title": "Status",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "dataset_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Dataset Manifest Hash",
          "type": "string"
        },
        "split_manifest_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Split Manifest Hash",
          "type": "string"
        },
        "git_sha": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[0-9a-f]{7,64}$",
          "title": "Git Sha",
          "type": "string"
        },
        "model_artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Artifact Checksum",
          "type": "string"
        },
        "dataset_name": {
          "minLength": 1,
          "title": "Dataset Name",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "locale": {
          "const": "us",
          "title": "Locale",
          "type": "string"
        },
        "base_model_id": {
          "minLength": 1,
          "title": "Base Model Id",
          "type": "string"
        },
        "base_model_revision": {
          "minLength": 1,
          "title": "Base Model Revision",
          "type": "string"
        },
        "training_strategy": {
          "minLength": 1,
          "title": "Training Strategy",
          "type": "string"
        },
        "training_provenance": {
          "$ref": "#/$defs/PublicTrainingProvenance"
        },
        "evaluation_provenance": {
          "$ref": "#/$defs/PublicEvaluationProvenance"
        },
        "metrics": {
          "$ref": "#/$defs/PublicRunMetrics"
        },
        "intervals": {
          "$ref": "#/$defs/PublicRunIntervals"
        },
        "test_access_count": {
          "minimum": 1,
          "title": "Test Access Count",
          "type": "integer"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "prohibited_claims": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prohibited Claims",
          "type": "array"
        },
        "reproduction_command": {
          "minLength": 1,
          "title": "Reproduction Command",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "config_hash",
        "dataset_manifest_hash",
        "split_manifest_hash",
        "git_sha",
        "model_artifact_checksum",
        "dataset_name",
        "dataset_version",
        "locale",
        "base_model_id",
        "base_model_revision",
        "training_strategy",
        "training_provenance",
        "evaluation_provenance",
        "metrics",
        "intervals",
        "test_access_count",
        "limitations",
        "prohibited_claims",
        "reproduction_command"
      ],
      "title": "PublicRunSummary",
      "type": "object"
    },
    "PublicSliceResult": {
      "additionalProperties": false,
      "properties": {
        "slice_id": {
          "minLength": 1,
          "title": "Slice Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "query_count": {
          "minimum": 0,
          "title": "Query Count",
          "type": "integer"
        },
        "excluded_query_count": {
          "minimum": 0,
          "title": "Excluded Query Count",
          "type": "integer"
        },
        "baseline_graded_ndcg_at_10": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Graded Ndcg At 10"
        },
        "candidate_graded_ndcg_at_10": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Graded Ndcg At 10"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "low_sample": {
          "title": "Low Sample",
          "type": "boolean"
        },
        "finding": {
          "enum": [
            "improvement",
            "regression",
            "uncertain",
            "insufficient_data"
          ],
          "title": "Finding",
          "type": "string"
        }
      },
      "required": [
        "slice_id",
        "display_name",
        "description",
        "query_count",
        "excluded_query_count",
        "baseline_graded_ndcg_at_10",
        "candidate_graded_ndcg_at_10",
        "delta",
        "low_sample",
        "finding"
      ],
      "title": "PublicSliceResult",
      "type": "object"
    },
    "PublicTrainingProvenance": {
      "additionalProperties": false,
      "description": "Allowlisted provenance for the validation-selected training execution.",
      "properties": {
        "trial_selection_id": {
          "pattern": "^trial-selection-[0-9a-f]{20}$",
          "title": "Trial Selection Id",
          "type": "string"
        },
        "trial_selection_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Trial Selection Sha256",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "selected_model_id": {
          "minLength": 1,
          "title": "Selected Model Id",
          "type": "string"
        },
        "selected_model_artifact_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Selected Model Artifact Checksum",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "hardware_class": {
          "enum": [
            "ml.m5.xlarge",
            "ml.g4dn.xlarge"
          ],
          "title": "Hardware Class",
          "type": "string"
        },
        "accelerator": {
          "enum": [
            "cpu",
            "gpu"
          ],
          "title": "Accelerator",
          "type": "string"
        },
        "region": {
          "const": "us-east-1",
          "title": "Region",
          "type": "string"
