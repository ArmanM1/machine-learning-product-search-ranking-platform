{
  "$id": "https://schemas.example.invalid/search-rank/protected_financial_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sanitized provenance for protected spend and applicable-credit inputs.",
  "properties": {
    "age_seconds_at_validation": {
      "maximum": 21600,
      "minimum": 0,
      "title": "Age Seconds At Validation",
      "type": "integer"
    },
    "authorization_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Authorization Commit Sha",
      "type": "string"
    },
    "authorization_input_sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Input Sha256",
      "type": "string"
    },
    "authorization_operation_id": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Operation Id",
      "type": "string"
    },
    "authorization_reservation_sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Reservation Sha256",
      "type": "string"
    },
    "authorization_workflow": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Authorization Workflow",
      "type": "string"
    },
    "campaign_spend_to_date_redacted": {
      "const": true,
      "title": "Campaign Spend To Date Redacted",
      "type": "boolean"
    },
    "maximum_age_seconds": {
      "const": 21600,
      "title": "Maximum Age Seconds",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "receipt_binding_algorithm": {
      "const": "hmac-sha256-v2",
      "title": "Receipt Binding Algorithm",
      "type": "string"
    },
    "receipt_sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]*[1-9a-f][0-9a-f]*$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "remaining_applicable_credit_redacted": {
      "const": true,
      "title": "Remaining Applicable Credit Redacted",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "aws_billing_and_cost_management_console",
      "title": "Source",
      "type": "string"
    },
    "validated_at": {
      "format": "date-time",
      "title": "Validated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "observed_at",
    "validated_at",
    "maximum_age_seconds",
    "age_seconds_at_validation",
    "source",
    "authorization_workflow",
    "authorization_operation_id",
    "authorization_input_sha256",
    "authorization_commit_sha",
    "authorization_reservation_sha256",
    "receipt_binding_algorithm",
    "receipt_sha256",
    "campaign_spend_to_date_redacted",
    "remaining_applicable_credit_redacted"
  ],
  "title": "ProtectedFinancialSnapshot",
  "type": "object"
}
