  "$id": "https://schemas.example.invalid/search-rank/portfolio_release_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One immutable, resume-safe release record assembled from the full evidence chain.",
  "properties": {
    "artifact_sha256": {
      "$ref": "#/$defs/PortfolioArtifactChecksums"
    },
    "benchmark": {
      "$ref": "#/$defs/PortfolioBenchmark"
    },
    "claim_boundaries": {
      "$ref": "#/$defs/PortfolioClaimBoundaries"
    },
    "deployment": {
      "$ref": "#/$defs/PortfolioDeployment"
    },
    "evidence_mode": {
      "const": "verified",
      "title": "Evidence Mode",
      "type": "string"
    },
    "evidence_status": {
      "const": "verified_measurement",
      "title": "Evidence Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "identities": {
      "$ref": "#/$defs/PortfolioReleaseIdentities"
    },
    "metrics": {
      "$ref": "#/$defs/PortfolioMetrics"
    },
    "public_demo_expires_at": {
      "format": "date-time",
      "title": "Public Demo Expires At",
      "type": "string"
    },
    "public_evidence": {
      "$ref": "#/$defs/PortfolioPublicEvidence"
    },
    "redeployment": {
      "$ref": "#/$defs/PortfolioRedeployment"
    },
    "release_gate": {
      "$ref": "#/$defs/PortfolioReleaseGate"
    },
    "release_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{2,127}$",
      "title": "Release Id",
      "type": "string"
    },
    "rollback": {
      "$ref": "#/$defs/PortfolioRollback"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_status",
    "generated_at",
    "public_demo_expires_at",
    "evidence_mode",
    "release_id",
    "identities",
    "release_gate",
    "metrics",
    "public_evidence",
    "deployment",
    "benchmark",
    "rollback",
    "redeployment",
    "claim_boundaries",
    "artifact_sha256"
  ],
  "title": "PortfolioReleaseEvidence",
  "type": "object"
}
