{
  "$id": "https://schemas.example.invalid/search-rank/cloud_training_job_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accelerator": {"enum": ["cpu", "gpu"], "title": "Accelerator", "type": "string"},
    "billable_seconds": {"minimum": 0, "title": "Billable Seconds", "type": "integer"},
    "config_file_sha256": {"pattern": "^[0-9a-f]{64}$", "title": "Config File Sha256", "type": "string"},
    "config_role": {"enum": ["candidate_treatment", "random_negative_control", "title_only_control"], "title": "Config Role", "type": "string"},
    "creation_time": {"format": "date-time", "title": "Creation Time", "type": "string"},
    "dataset_manifest_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Dataset Manifest Hash", "type": "string"},
    "end_time": {"format": "date-time", "title": "End Time", "type": "string"},
    "git_sha": {"pattern": "^[0-9a-f]{40}$", "title": "Git Sha", "type": "string"},
    "image_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Image Digest", "type": "string"},
    "image_source_tag": {"pattern": "^sha-[0-9a-f]{40}$", "title": "Image Source Tag", "type": "string"},
    "image_uri": {"pattern": "^[0-9]{12}\\.dkr\\.ecr\\.us-east-1\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[0-9a-f]{64}$", "title": "Image Uri", "type": "string"},
    "instance_count": {"const": 1, "title": "Instance Count", "type": "integer"},
    "instance_type": {"enum": ["ml.m5.xlarge", "ml.g4dn.xlarge"], "title": "Instance Type", "type": "string"},
    "managed_spot": {"const": true, "title": "Managed Spot", "type": "boolean"},
    "model_artifact_key": {"pattern": "^runs/[A-Za-z0-9._/-]+\\.tar\\.gz$", "title": "Model Artifact Key", "type": "string"},
    "output_key_prefix": {"pattern": "^runs/[A-Za-z0-9._/-]+/$", "title": "Output Key Prefix", "type": "string"},
    "region": {"const": "us-east-1", "title": "Region", "type": "string"},
    "repository_dirty": {"const": false, "title": "Repository Dirty", "type": "boolean"},
    "run_kind": {"enum": ["development", "ablation", "final"], "title": "Run Kind", "type": "string"},
    "status": {"const": "Completed", "title": "Status", "type": "string"},
    "training_job_name": {"pattern": "^product-search-ranking-prod-[a-z]+-[0-9]+$", "title": "Training Job Name", "type": "string"},
    "training_seconds": {"minimum": 0, "title": "Training Seconds", "type": "integer"},
    "training_start_time": {"format": "date-time", "title": "Training Start Time", "type": "string"}
  },
  "required": [
    "training_job_name", "status", "instance_type", "instance_count", "accelerator",
    "config_role", "run_kind", "region", "managed_spot", "training_seconds",
    "billable_seconds", "creation_time", "training_start_time", "end_time", "git_sha",
    "repository_dirty", "dataset_manifest_hash", "config_file_sha256", "image_uri",
    "image_digest", "image_source_tag", "output_key_prefix", "model_artifact_key"
  ],
  "title": "CloudTrainingJobEvidence",
  "type": "object"
}
