# syntax=docker/dockerfile:1.7
# Both release-stage images use Linux/amd64 digests refreshed on 2026-09-02,
# matching the project's x86_64 deployment contract.
FROM node:22-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96 AS web-build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY web ./
RUN npm run build

FROM python:3.11.16-slim-bookworm@sha256:b1add8a6f2aca6bcfcf0b9c9b522352f7ce0d62a3d556a2f2f32511aa0cca250

ARG UV_VERSION=0.12.9
ARG APP_UID=10001
ARG APP_GID=10001
ARG MODEL_ARTIFACT_DIR=scripts/container-assets/empty-release

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/search-rank-venv \
    LAMBDA_TASK_ROOT=/var/task \
    PATH="/opt/search-rank-venv/bin:${PATH}" \
    PYTHONPATH="/opt/search-rank-venv/lib/python3.11/site-packages:${LAMBDA_TASK_ROOT}" \
    HF_HOME=/tmp/huggingface \
    TRANSFORMERS_CACHE=/tmp/huggingface

WORKDIR ${LAMBDA_TASK_ROOT}

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY --from=web-build /web/dist ./web/dist
COPY ${MODEL_ARTIFACT_DIR} ./release

RUN system_python="$(command -v python)" \
    && "${system_python}" -m pip install --no-cache-dir "uv==${UV_VERSION}" \
    && uv sync --frozen --no-dev --no-editable --extra serve \
    && uv cache clean \
    && "${system_python}" -m pip uninstall --yes uv setuptools wheel \
    && "${system_python}" -c 'import pathlib, shutil, sysconfig; path = pathlib.Path(sysconfig.get_paths()["purelib"]) / "setuptools"; shutil.rmtree(path) if path.exists() else None' \
    && chmod -R a=rX "${LAMBDA_TASK_ROOT}" /opt/search-rank-venv

# Lambda also supplies a least-privileged user, but the image declares one so
# local execution and image scanners verify the same non-root boundary.
USER ${APP_UID}:${APP_GID}

ENTRYPOINT ["/opt/search-rank-venv/bin/python", "-m", "awslambdaric"]
CMD ["search_rank.serving.app.handler"]
