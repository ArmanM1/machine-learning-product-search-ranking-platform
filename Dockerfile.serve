# syntax=docker/dockerfile:1.7
# Both release-stage images use Linux/amd64 digests refreshed on 2026-09-02,
# matching the project's x86_64 deployment contract.
FROM node:22-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96 AS web-build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY web ./
RUN npm run build

FROM public.ecr.aws/lambda/python:3.12@sha256:c852b0b4649ab25e5020a85e4073100d9c2c1da90e0ffb86ea2e5c7ae07b7478

ARG UV_VERSION=0.12.9
ARG APP_UID=10001
ARG APP_GID=10001
ARG MODEL_ARTIFACT_DIR=scripts/container-assets/empty-release

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/search-rank-venv \
    PATH="/opt/search-rank-venv/bin:${PATH}" \
    PYTHONPATH="/opt/search-rank-venv/lib/python3.12/site-packages:${LAMBDA_TASK_ROOT}" \
    HF_HOME=/tmp/huggingface \
    TRANSFORMERS_CACHE=/tmp/huggingface

WORKDIR ${LAMBDA_TASK_ROOT}

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY --from=web-build /web/dist ./web/dist
COPY ${MODEL_ARTIFACT_DIR} ./release

RUN dnf upgrade -y openssl-fips-provider-latest openssl-snapsafe-libs \
    && dnf clean all \
    && system_python="$(command -v python)" \
    && "${system_python}" -m pip install --no-cache-dir "uv==${UV_VERSION}" \
    && uv sync --frozen --no-dev --no-editable \
    && "${system_python}" -m pip uninstall --yes uv setuptools wheel \
    && chmod -R a=rX "${LAMBDA_TASK_ROOT}" /opt/search-rank-venv

# Lambda also supplies a least-privileged user, but the image declares one so
# local execution and image scanners verify the same non-root boundary.
USER ${APP_UID}:${APP_GID}

CMD ["search_rank.serving.app.handler"]
